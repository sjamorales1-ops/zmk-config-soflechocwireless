#include <input/processors.dtsi>

/*
 * Temporarily here because nice nano v2 spi is not defined on ZMK Yet
 * Source: https://github.com/zmkfirmware/zmk/blob/main/app/boards/shields/reviung41/boards/nice_nano.overlay
 * GitHub Issue: https://github.com/zmkfirmware/zmk/issues/885
 */

#include <dt-bindings/led/led.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&pinctrl {
    spi3_default: spi3_default {
        group1 { psels = <NRF_PSEL(SPIM_MOSI, 0, 8)>; };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 8)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        label = "WS2812";

        /* SPI */

        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;

        /* WS2812 */

        chain-length = <30>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

&mt {
    tapping-term-ms = <250>;
    flavor = "balanced";
};

&lt {
    tapping-term-ms = <250>;
    flavor = "balanced";
};

/ {
    chosen { zmk,underglow = &led_strip; };
};

/* END temporary RGB support section */

/ {
    combos {
        compatible = "zmk,combos";

        Capsv1 {
            bindings = <&kp CAPSLOCK>;
            key-positions = <42 43>;
        };

        TypingLayer {
            bindings = <&tog 1>;
            key-positions = <1 50>;
            layers = <0 1>;
        };
    };

    behaviors {
        layer_tap_v2: layer_tap_v2 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_V2";
            bindings = <&mo>, <&rgb_ug>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            // ------------------------------------------------------------------------------------------------------------------
            // |  `    |  1  |  2  |  3   |  4   |  5   |                         |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                         |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                         |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |        | ExtPw |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |        | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp EQUAL   &kp N1          &kp N2          &kp N3       &kp N4       &kp N5                                  &kp N6     &kp N7       &kp N8       &kp N9           &kp N0         &kp MINUS
&kp TAB     &kp Q           &kp W           &kp F        &kp P        &kp B                                   &kp J      &kp L        &kp U        &kp Y            &kp SEMICOLON  &kp NON_US_BACKSLASH
&kp ESCAPE  &mt LEFT_GUI A  &mt LEFT_ALT R  &mt LCTRL S  &mt LSHFT T  &kp G                                   &kp M      &mt RSHFT N  &mt RCTRL E  &mt RIGHT_ALT I  &mt RGUI O     &kp SQT
&mo 2       &kp Z           &kp X           &kp C        &kp D        &kp V          &caps_word    &kp RSHFT  &kp K      &kp H        &kp COMMA    &kp DOT          &kp FSLH       &mo 3
                            &kp LGUI        &kp LALT     &lt 5 LCTRL  &kp BACKSPACE  &kp DELETE    &kp ENTER  &kp SPACE  &lt 4 RCTRL  &kp RALT     &kp RGUI
            >;
        };

        Typing {
            bindings = <
&kp EQUAL  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                          &kp N6  &kp N7  &kp N8     &kp N9   &kp N0         &kp MINUS
&trans     &kp Q   &kp W   &kp F   &kp P   &kp B                           &kp J   &kp L   &kp U      &kp Y    &kp SEMICOLON  &kp NON_US_BACKSLASH
&trans     &kp A   &kp R   &kp S   &kp T   &kp G                           &kp M   &kp N   &kp E      &kp I    &kp O          &kp SQT
&trans     &kp Z   &kp X   &kp C   &kp D   &kp V   &kp LSHFT    &kp RSHFT  &kp K   &kp H   &kp COMMA  &kp DOT  &kp FSLH       &trans
                   &trans  &trans  &trans  &trans  &trans       &trans     &trans  &trans  &trans     &trans
            >;
        };

        Lower {
            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // | `     |   1 |   2 |   3  |   4  |   5  |                   |   6  |   7   |   8   |   9  |    0  |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&trans  &trans  &trans    &trans        &trans     &kp HOME                         &kp LEFT_PARENTHESIS   &kp KP_NUMLOCK  &kp KP_EQUAL     &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp F12
&trans  &none   &none     &kp UP_ARROW  &none      &kp END                          &kp RIGHT_PARENTHESIS  &kp N7          &kp N8           &kp N9         &kp KP_MINUS     &kp KP_DIVIDE
&trans  &none   &kp LEFT  &kp DOWN      &kp RIGHT  &kp PAGE_UP                      &kp DOLLAR             &kp N4          &kp N5           &kp N6         &kp KP_PLUS      &trans
&trans  &none   &none     &none         &none      &kp PAGE_DOWN  &trans    &trans  &kp KP_COMMA           &kp N1          &kp N2           &kp N3         &kp KP_ENTER     &trans
                &trans    &trans        &trans     &trans         &trans    &trans  &trans                 &kp KP_N0       &kp KP_NUMBER_0  &kp KP_DOT
            >;
        };

        Media_Function {
            bindings = <
&none  &kp C_STOP  &kp C_MUTE    &kp C_PLAY_PAUSE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP                    &kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6
&none  &none       &kp C_REWIND  &kp C_FAST_FORWARD  &kp C_PREV         &kp C_NEXT                         &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&none  &none       &none         &none               &none              &none                              &none   &none   &none   &none    &none    &none
&none  &kp LC(Z)   &kp LC(X)     &kp LC(C)           &kp LC(V)          &kp LC(Y)        &trans    &trans  &none   &none   &none   &none    &none    &none
                   &none         &none               &none              &none            &none     &none   &none   &none   &none   &none
            >;
        };

        Mouse {
            bindings = <
&trans  &trans          &trans          &trans          &trans           &trans                               &trans          &trans          &trans          &trans           &trans     &trans
&trans  &trans          &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &trans                               &trans          &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &trans     &trans
&trans  &msc SCRL_UP    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_UP                         &msc SCRL_UP    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp LCLK  &trans
&trans  &msc SCRL_DOWN  &trans          &trans          &trans           &msc SCRL_DOWN  &trans       &trans  &msc SCRL_DOWN  &trans          &trans          &trans           &mkp RCLK  &trans
                        &trans          &trans          &trans           &mkp LCLK       &mkp RCLK    &trans  &trans          &trans          &trans          &trans
            >;
        };

        raise {
            // ------------------------------------------------------------------------------------------------------------
            // |BTCLR| BT1  | BT2  |  BT3  |  BT4  |  BT5 |                 |      |      |       |      |       |       |
            // |     | INS  | PSCR | GUI   |       |      |                 | PGUP |      |   ^   |      |       |       |
            // |     | ALT  | CTRL | SHIFT |       | CAPS |                 | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |     | UNDO | CUT  | COPY  | PASTE |      |      |   | RGB  |      |      |       |      |       |       |
            //              |      |       |       |      |      |   |      |      |      |       |      |

            bindings = <
&bt BT_CLR    &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                                         &trans     &trans    &trans    &trans     &trans   &trans
&out OUT_TOG  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &rgb_ug RGB_TOG                                      &kp PG_UP  &trans    &kp UP    &trans     &trans   &trans
&sys_reset    &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &rgb_ug RGB_EFF                                      &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&bootloader   &kp RC(Z)        &kp RC(X)        &kp RC(C)        &kp RC(V)        &rgb_ug RGB_COLOR_HSB(172,100,50)  &trans    &trans  &trans     &trans    &trans    &trans     &trans   &bootloader
                               &trans           &trans           &trans           &trans                             &trans    &trans  &trans     &trans    &trans    &trans
            >;
        };
    };
};
