#include <input/processors.dtsi>

/*
 * Temporarily here because nice nano v2 spi is not defined on ZMK Yet
 * Source: https://github.com/zmkfirmware/zmk/blob/main/app/boards/shields/reviung41/boards/nice_nano.overlay
 * GitHub Issue: https://github.com/zmkfirmware/zmk/issues/885
 */

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30   // default: 10

#include <dt-bindings/led/led.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&pinctrl {
    spi3_default: spi3_default {
        group1 { psels = <NRF_PSEL(SPIM_MOSI, 0, 8)>; };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 8)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        label = "WS2812";

        /* SPI */

        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;

        /* WS2812 */

        chain-length = <30>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

&mt {
    tapping-term-ms = <250>;
    flavor = "balanced";
};

&lt {
    tapping-term-ms = <250>;
    flavor = "balanced";
};

/ {
    chosen { zmk,underglow = &led_strip; };
};

/* END temporary RGB support section */

/ {
    combos {
        compatible = "zmk,combos";

        Capsv1 {
            bindings = <&kp CAPSLOCK>;
            key-positions = <42 43>;
            layers = <0 1 2>;
        };

        TypingLayer {
            bindings = <&tog 1>;
            key-positions = <1 50>;
            layers = <0 1>;
        };
    };

    behaviors {
        layer_tap_v2: layer_tap_v2 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_V2";
            bindings = <&mo>, <&rgb_ug>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "balanced";
        };

        lowertapdance: lowertapdance {
            compatible = "zmk,behavior-tap-dance";
            label = "LOWERTAPDANCE";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&to 2>;

            tapping-term-ms = <250>;
        };
    };

    macros {
        extend_line: extend_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(END)>;
            label = "EXTEND_LINE";
        };

        extend_word: extend_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(RIGHT))>;
            label = "EXTEND_WORD";
        };

        select_line: select_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(END)>;
            label = "SELECT_LINE";
        };

        select_word: select_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT) &kp LC(LS(RIGHT))>;
            label = "SELECT_WORD";
        };

        select_none: select_none {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOWN &kp UP_ARROW &kp RIGHT &kp LEFT>;
            label = "SELECT_NONE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "BASE";

            // ------------------------------------------------------------------------------------------------------------------
            // |  `    |  1  |  2  |  3   |  4   |  5   |                         |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                         |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                         |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |        | ExtPw |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |        | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp EQUAL   &kp N1          &kp N2          &kp N3       &kp N4       &kp N5                                       &kp N6     &kp N7       &kp N8       &kp N9           &kp N0         &kp MINUS
&kp TAB     &kp Q           &kp W           &kp F        &kp P        &kp B                                        &kp J      &kp L        &kp U        &kp Y            &kp SEMICOLON  &kp NON_US_BACKSLASH
&kp ESCAPE  &mt LEFT_GUI A  &mt LEFT_ALT R  &mt LCTRL S  &mt LSHFT T  &kp G                                        &kp M      &mt RSHFT N  &mt RCTRL E  &mt RIGHT_ALT I  &mt RGUI O     &kp SQT
&kp LSHFT   &kp Z           &kp X           &kp C        &kp D        &kp V          &caps_word    &lowertapdance  &kp K      &kp H        &kp COMMA    &kp DOT          &kp FSLH       &mo 3
                            &kp LGUI        &kp LALT     &lt 5 LCTRL  &kp BACKSPACE  &kp DELETE    &kp ENTER       &kp SPACE  &lt 4 RCTRL  &kp RALT     &kp RGUI
            >;
        };

        Typing {
            label = "TYPE";
            bindings = <
&kp EQUAL  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                          &kp N6  &kp N7  &kp N8     &kp N9   &kp N0         &kp MINUS
&trans     &kp Q   &kp W   &kp F   &kp P   &kp B                           &kp J   &kp L   &kp U      &kp Y    &kp SEMICOLON  &kp NON_US_BACKSLASH
&trans     &kp A   &kp R   &kp S   &kp T   &kp G                           &kp M   &kp N   &kp E      &kp I    &kp O          &kp SQT
&trans     &kp Z   &kp X   &kp C   &kp D   &kp V   &kp LSHFT    &kp RSHFT  &kp K   &kp H   &kp COMMA  &kp DOT  &kp FSLH       &trans
                   &trans  &trans  &trans  &trans  &trans       &trans     &trans  &trans  &trans     &trans
            >;
        };

        Lower {
            label = "LOWER";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // | `     |   1 |   2 |   3  |   4  |   5  |                   |   6  |   7   |   8   |   9  |    0  |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&trans  &trans     &trans          &trans        &trans         &trans                       &kp LEFT_PARENTHESIS   &kp KP_NUMLOCK  &kp KP_EQUAL     &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp PRINTSCREEN
&trans  &kp HOME   &kp END         &kp PAGE_UP   &kp PAGE_DOWN  &kp LC(X)                    &kp RIGHT_PARENTHESIS  &kp N7          &kp N8           &kp N9         &kp KP_MINUS     &kp SCROLLLOCK
&trans  &kp LC(Y)  &trans          &kp UP_ARROW  &trans         &kp LC(C)                    &kp DOLLAR             &kp N4          &kp N5           &kp N6         &kp KP_PLUS      &kp LA(LC(M))
&trans  &kp LC(Z)  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT      &kp LC(V)  &trans    &trans  &kp KP_COMMA           &kp N1          &kp N2           &kp N3         &kp KP_ENTER     &trans
                   &kp LBKT        &kp RBKT      &kp GRAVE      &trans     &trans    &trans  &trans                 &kp KP_N0       &kp KP_NUMBER_0  &kp KP_DOT
            >;
        };

        FN-Cursor {
            label = "CUR-FN";
            bindings = <
&none   &kp C_STOP  &kp C_MUTE    &kp C_PLAY_PAUSE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP                                &kp F1        &kp F2    &kp F3        &kp F4     &kp F5     &kp F6
&trans  &none       &kp C_REWIND  &kp C_FAST_FORWARD  &kp C_PREV         &kp C_NEXT                                     &kp F7        &kp F8    &kp F9        &kp F10    &kp F11    &kp F12
&trans  &kp HOME    &kp END       &kp PAGE_UP         &kp PAGE_DOWN      &kp BACKSPACE                                  &select_none  &none     &kp UP_ARROW  &none      &kp LC(F)  &none
&trans  &kp LC(Z)   &kp LC(X)     &kp LC(C)           &kp LC(V)          &kp LC(Y)        &kp DELETE      &kp INSERT    &kp LC(A)     &kp LEFT  &kp DOWN      &kp RIGHT  &kp LC(H)  &trans
                    &trans        &trans              &trans             &extend_word     &extend_line    &select_word  &select_line  &none     &none         &none
            >;
        };

        Mouse {
            label = "MOUSE";
            bindings = <
&none   &none           &none           &none           &none            &none                               &none           &none           &none           &none            &none      &none
&trans  &none           &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &msc SCRL_UP                        &msc SCRL_UP    &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &none      &none
&trans  &msc SCRL_UP    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN                      &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp LCLK  &none
&trans  &msc SCRL_DOWN  &none           &none           &none            &none           &none        &none  &none           &none           &none           &none            &mkp RCLK  &trans
                        &none           &none           &none            &mkp LCLK       &mkp RCLK    &none  &none           &none           &none           &none
            >;
        };

        Raise {
            label = "RAISE";

            // ------------------------------------------------------------------------------------------------------------
            // |BTCLR| BT1  | BT2  |  BT3  |  BT4  |  BT5 |                 |      |      |       |      |       |       |
            // |     | INS  | PSCR | GUI   |       |      |                 | PGUP |      |   ^   |      |       |       |
            // |     | ALT  | CTRL | SHIFT |       | CAPS |                 | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |     | UNDO | CUT  | COPY  | PASTE |      |      |   | RGB  |      |      |       |      |       |       |
            //              |      |       |       |      |      |   |      |      |      |       |      |

            bindings = <
&bt BT_CLR   &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                                       &none  &none  &none  &none  &none  &studio_unlock
&sys_reset   &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &rgb_ug RGB_TOG                                    &none  &none  &none  &none  &none  &sys_reset
&bootloader  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &rgb_ug RGB_EFF                                    &none  &none  &none  &none  &none  &bootloader
&none        &kp RC(Z)        &kp RC(X)        &kp RC(C)        &kp RC(V)        &rgb_ug RGB_COLOR_HSB(172,100,50)  &none    &none  &none  &none  &none  &none  &none  &out OUT_TOG
                              &none            &none            &none            &none                              &none    &none  &none  &none  &none  &none
            >;
        };
    };
};

/ {
    underglow-layer {
      compatible  = "zmk,underglow-layer";

      //
      // color definitions from QMK
      // https://github.com/qmk/qmk_firmware/blob/master/quantum/color.h
      //
      #define RGB_AZURE     0x99F5FF // #99F5FF
      #define RGB_BLACK     0x000000 // #000000
      #define RGB_BLUE      0x0000FF // #0000FF
      #define RGB_CHARTRSE  0x80FF00 // #80FF00
      #define RGB_CORAL     0xFF7C4D // #FF7C4D
      #define RGB_CYAN      0x00FFFF // #00FFFF
      #define RGB_GOLD      0xFFD900 // #FFD900
      #define RGB_GOLDNROD  0xD9A521 // #D9A521
      #define RGB_GREEN     0x00FF00 // #00FF00
      #define RGB_MAGENTA   0xFF00FF // #FF00FF
      #define RGB_ORANGE    0xFF8000 // #FF8000
      #define RGB_PINK      0xFF80BF // #FF80BF
      #define RGB_PURPLE    0x7A00FF // #7A00FF
      #define RGB_RED       0xFF0000 // #FF0000
      #define RGB_SPRINGRN  0x00FF80 // #00FF80
      #define RGB_TEAL      0x008080 // #008080
      #define RGB_TURQUOIS  0x476E6A // #476E6A
      #define RGB_WHITE     0xFFFFFF // #FFFFFF
      #define RGB_YELLOW    0xFFFF00 // #FFFF00

      //
      // color definitions from MoErgo
      // https://github.com/moergo-sc/zmk/blob/aca523dfce9b6447ffd19d833b791d44f1f286de/app/src/rgb_underglow.c#L259-L265
      //
      #define RGB_DULL_GRN  0x00ff68 // #00ff68
      #define RGB_LILAC     0x6b1fce // #6b1fce

      //
      // underglow for the colors above
      //
      #define AZURE     &ug RGB_AZURE
      #define BLACK     &ug RGB_BLACK
      #define BLUE      &ug RGB_BLUE
      #define CHARTRSE  &ug RGB_CHARTRSE
      #define CORAL     &ug RGB_CORAL
      #define CYAN      &ug RGB_CYAN
      #define GOLD      &ug RGB_GOLD
      #define GOLDNROD  &ug RGB_GOLDNROD
      #define GREEN     &ug RGB_GREEN
      #define MAGENTA   &ug RGB_MAGENTA
      #define ORANGE    &ug RGB_ORANGE
      #define PINK      &ug RGB_PINK
      #define PURPLE    &ug RGB_PURPLE
      #define RED       &ug RGB_RED
      #define SPRINGRN  &ug RGB_SPRINGRN
      #define TEAL      &ug RGB_TEAL
      #define TURQUOIS  &ug RGB_TURQUOIS
      #define WHITE     &ug RGB_WHITE
      #define YELLOW    &ug RGB_YELLOW
      #define ________  &ug RGB_BLACK
      #define DULL_GRN  &ug RGB_DULL_GRN
      #define LILAC     &ug RGB_LILAC


      /*
      Template {
        bindings = <
           ________  ________  ________  ________  ________  ________                      ________  ________  ________  ________  ________  ________
           ________  ________  ________  ________  ________  ________                      ________  ________  ________  ________  ________  ________
           ________  ________  ________  ________  ________  ________                      ________  ________  ________  ________  ________  ________
           ________  ________  ________  ________  ________  ________  ________  ________  ________  ________  ________  ________  ________  ________
                               ________  ________  ________  ________  ________  ________  ________  ________  ________  ________
        >;

        layer-id = <LAYER_Template>;
      }; */


      Base {
        bindings = <
          &ug ________  &ug ________  &ug ________   &ug ________  &ug ________  &ug ________                              &ug ________  &ug ________  &ug ________  &ug ________  &ug ________  &ug ________
          &ug ________  &ug ________  &ug ________   &ug ________  &ug ________  &ug ________                              &ug ________  &ug ________  &ug ________  &ug ________  &ug ________  &ug ________
          &ug ________  &ug MAGENTA   &ug CYAN       &ug GREEN     &ug YELLOW    &ug ________                              &ug ________  &ug YELLOW    &ug GREEN     &ug CYAN      &ug MAGENTA   &ug ________
          &ug YELLOW    &ug ________  &ug ________   &ug ________  &ug ________  &ug ________  &ug YELLOW    &ug GREEN     &ug ________  &ug ________  &ug ________  &ug ________  &ug ________  &ug ________
                                      &ug MAGENTA    &ug CYAN      &ug GREEN     &ug ________  &ug ________  &ug ________  &ug ________  &ug GREEN     &ug CYAN      &ug MAGENTA 
        >;

        layer-id = <0>;
      };
    };
   };
